/*
 * TQMLS102xa RCW configuration for 1000MHz QSPI-Boot
 *
 */

#include <../ls1021aqds/ls1021a.rcwi>

SYS_PLL_RAT=3
MEM_PLL_RAT=8
CGA_PLL1_RAT=10
/* Serdes:
 * A: PCIe1
 * B: SATA1
 * C: PCIe2
 * D: SGMII2
 */
SRDS_PRTCL_S1=112
/* PLL1/2 not powered down */
SRDS_PLL_PD_S1=0
SRDS_DIV_PEX=1

USB3_REFCLK_SEL=0
USB3_CLK_FSEL=57
A7_ACE_CLKDIV=2
A7_DBG_CLKDIV=2
HWA_CGA_M1_CLK_SEL=1

DP_DIV=1
OCN_DIV=1
DRAM_LAT=1
SYS_PLL_SPD=1
UART_EXT=4
IIC_EXT=2
SDHC_EXT=0
UART_BASE=7
ASLEEP=1
RTC=0
EVT9_B=1
IRQ_BASE=448
IFC_GRP_A_EXT=1
IFC_GRP_D_EXT=1
IFC_GRP_E1_EXT=1
IFC_GRP_F_EXT=1
IFC_GRP_G_EXT=1
IFC_GRP_E1_BASE=0
IFC_GRP_D_BASE=1
IFC_GRP_A_BASE=0
EC1=4
EC2=4
EC3=0
MDC_MDIO=0
QE_TDMA=6
QE_TDMB=6
SDHC=0
DVDD_VSEL=2
LVDD_VSEL=1
EVDD_VSEL=2
BVDD_VSEL=2
